.env
node_modules/

# ---- お客さんのデータをGitHubに上げないための設定 ----
# サンプルや作業用のフォルダ（お客さんの実データを含む可能性がある）
samples/
data/
private/

# 試算表・領収書・マスタになりうるファイルは、どこに置いても上げない
